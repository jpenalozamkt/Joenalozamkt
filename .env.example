# Copia este archivo como .env.local para trabajar en tu computadora.
# En Vercel, estas mismas variables van en Settings → Environment Variables.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Secreta: nunca la compartas ni la pongas en el navegador
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Código que pide la pantalla de configuración inicial para crear el primer administrador.
# Inventa uno largo; deja de servir en cuanto existe un administrador.
SETUP_CODE=cambia-esto-por-un-codigo-largo

# Dominio interno para convertir el usuario en correo de inicio de sesión (no se envían correos).
AUTH_EMAIL_DOMAIN=usuarios.hub-jpmkt.app
